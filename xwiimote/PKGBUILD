# Contributor: Luca Weiss <luca (at) z3ntu (dot) xyz>

pkgname=xwiimote
pkgver=2.r29.g4df713d
pkgrel=2
pkgdesc="Open Source Nintendo Wii Remote Linux Device Driver"
url="https://github.com/xwiimote/xwiimote"
arch=('x86_64' 'powerpc' 'powerpc64' 'powerpc64le' 'espresso')
license=('MIT')
depends=('libsystemd')
makedepends=('systemd')
conflicts=('xwiimote-git')
backup=('etc/X11/xorg.conf.d/50-fix-xwiimote.conf')
_commit=4df713d9037d814cc0c64197f69e5c78d55caaf1
source=("${url}/archive/${_commit}.tar.gz")
sha256sums=('dc4713949a9b2bb48bd79a5c87c0219d7b20f7933c62da7635bad45267ae9a1a')

prepare() {
  cd "$pkgname-$_commit"
  NOCONFIGURE=1 ./autogen.sh
}

build() {
  cd "$pkgname-$_commit"
  ./configure --prefix=/usr --with-doxygen=no
  make
}

package() {
  cd "$pkgname-$_commit"
  make DESTDIR="$pkgdir" install
  install -m644 -D LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -m644 -D "res/50-xorg-fix-xwiimote.conf" "$pkgdir/etc/X11/xorg.conf.d/50-fix-xwiimote.conf"
}
