pkgname=ecl
pkgver=26.3.27
pkgrel=1
pkgdesc='Embeddable Common Lisp'

arch=(x86_64 powerpc powerpc64 powerpc64le espresso)
url='https://common-lisp.net/project/ecl/'
license=(LGPL-2.1-or-later)
depends=(
  bash
  glibc
  gmp
  libffi
  libgcc
)
makedepends=(texinfo)
provides=(common-lisp cl-asdf)
options=(!makeflags)
source=("https://common-lisp.net/project/ecl/static/files/release/${pkgname}-${pkgver}.tgz")
sha512sums=('a6a8a40f63b44229fb84239cf5f1048e0a99bc36ec3fc1925409ad344884997de125ac1954cf0fb715529efb602649735e739f73827a834fb117512cf2e7879d')
b2sums=('6cb8703e37eb2f24eaf375dbb77bb9a9a2b526de640441a91b459bd4ca9bfc589cfc6ce180b6040157c86db338ae8e9f16c01ab355fcb2764bb8afd1742f9ac5')

prepare() {
  cd "$pkgname-$pkgver"

  sed \
    -e 's|-Wl,--rpath,~A|-Wl,--rpath,/usr/lib/ecl|' \
    -i src/configure
}

build() {
  cd "$pkgname-$pkgver"

  local configure_options=(
    --build=$CHOST
    --prefix=/usr
    --with-tcp
    --with-serve-event
    --with-clos-streams
    --with-system-gmp
    --without-x
    --without-clx
    --enable-threads
    --enable-shared
    --enable-boehm=included
  )

  export CFLAGS+=" -fcommon -ffat-lto-objects"

  ./configure "${configure_options[@]}"

  make
}

package() {
  make -C "$pkgname-$pkgver" DESTDIR="$pkgdir" install
}


apb_extra_repos=(
  "extra-any::https://repo.wii-linux.org/arch/extra/any"
  "extra::https://repo.wii-linux.org/arch/extra/$arch"
)
