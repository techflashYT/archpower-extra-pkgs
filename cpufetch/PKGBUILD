# Contributor: Luis Martinez <luis dot martinez at disroot dot org>
# Contributor: Dr-Noob <peibolms at gmail dot com>

pkgname=cpufetch
pkgver=1.07
pkgrel=1
pkgdesc="Simple yet fancy CPU architecture fetching tool"
arch=(x86_64 powerpc powerpc64 powerpc64le espresso)
url="https://github.com/Dr-Noob/cpufetch"
license=(MIT)
depends=(glibc)
source=(
  "$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz"
  "check-for-l2.patch"
  "fix-ppc-build.patch"
)
sha256sums=('dc3ec8f9c9d41d8434702a778cc150b196d5d178fd768a964f57d22f268a2c17'
            '2af2dc1f3ac70d59586ede2930a49c517a01cb7bbbfe2a32f4abb173d0719a09'
	    'b53112adb769ecb34f3c9d4921f580eb3eff3e3381ff8051a74be9a11d12ccad')

prepare() {
  cd $pkgname-$pkgver
  # cpufetch does not check for L2 cache, and will give an
  # assertion failure should it run on a CPU where it is
  # not present.  Patch this here.
  patch -Np1 < ../check-for-l2.patch
  # https://github.com/Dr-Noob/cpufetch/pull/376
  patch -Np1 < ../fix-ppc-build.patch
  sed -i 's/cpufetch-git/cpufetch/g' Makefile
}

build() {
  cd $pkgname-$pkgver
  CFLAGS="$CFLAGS $LDFLAGS" make GIT_VERSION="$pkgver"
}

package() {
  cd $pkgname-$pkgver
  make DESTDIR="$pkgdir" install
}

apb_extra_repos=(
  "extra-any::https://repo.wii-linux.org/arch/extra/any"
  "extra::https://repo.wii-linux.org/arch/extra/$arch"
)

